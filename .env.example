# Configurações da Aplicação
PORT=8080
GRPC_PORT=50051
ENVIRONMENT=development

# Configurações do Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=app_db

# Configurações de Segurança
JWT_SECRET=your-very-secure-jwt-secret-key-change-in-production

# URL completa do banco (alternativa às configurações individuais)
# DATABASE_URL=mysql://root:123456@localhost:3306/app_db

# Framework Providers Configuration
# Payment Providers
STRIPE_API_KEY=your-stripe-key
MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-token

# Maps Providers  
GOOGLE_MAPS_API_KEY=your-google-maps-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Cache Providers
REDIS_URL=redis://localhost:6379/0

# Email Providers
SENDGRID_API_KEY=your-sendgrid-key